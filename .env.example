# Server
PORT=4000
MONGODB_URI=mongodb://localhost:27017/agentone
SESSION_SECRET=change-me-in-production
CLIENT_ORIGIN=http://localhost:5173

# LLM adapter — provider is "mock" by default so the app runs with zero setup.
# Switch to "gemini" or "groq" and set LLM_API_KEY once you have a free-tier key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# Google sign-in (optional). Leave blank to use dev-mode login instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# API
PORT=4000
MONGODB_URI=mongodb://localhost:27017/agentone
SESSION_SECRET=change-me-in-production
CLIENT_ORIGIN=http://localhost:5173

# Redis / BullMQ (worker, Phase 2 eval harness)
REDIS_URL=redis://localhost:6379

# Eval harness SSRF protection (api/src/harness/safeFetch.js) blocks private,
# metadata and loopback addresses unconditionally. Set this to "true" only to
# let the harness reach a manifest endpoint on localhost — needed to run the
# dev-fixtures/ test agents locally. Private ranges and the cloud metadata
# address stay blocked either way; this affects loopback only. NEVER set this
# in anything resembling a production environment.
ALLOW_LOOPBACK_ENDPOINTS=false

# LLM adapter — used by the eval harness's judge and the flagship agents
# (Phase 2+). Provider is "mock" by default; real eval runs need a real key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# GitHub sign-in (optional). Leave blank to use dev-mode login instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Google sign-in (optional). Leave blank to use dev-mode login instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

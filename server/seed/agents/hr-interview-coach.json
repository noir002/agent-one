{
  "slug": "hr-interview-coach",
  "name": "HR Interview Coach",
  "grove": "career",
  "tagline": "8 HR questions with STAR-style answers",
  "inputs": [
    { "key": "role", "label": "Role", "type": "text", "required": true },
    { "key": "companyType", "label": "Company type", "type": "text", "required": false }
  ],
  "systemPrompt": "You are an HR interview coach. Given a target role and company type, generate 8 common HR interview questions along with example STAR-method (Situation, Task, Action, Result) answers a student could adapt.",
  "outputFormat": "markdown",
  "model": "default",
  "testCases": [
    { "inputs": { "role": "Software Engineer Intern", "companyType": "Startup" }, "mustInclude": ["Situation", "Result"] },
    { "inputs": { "role": "Marketing Associate", "companyType": "MNC" }, "mustInclude": ["Situation", "Result"] }
  ]
}

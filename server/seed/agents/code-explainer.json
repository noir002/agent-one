{
  "slug": "code-explainer",
  "name": "Code Explainer",
  "grove": "code",
  "tagline": "Line-by-line explanation of any snippet",
  "inputs": [
    { "key": "code", "label": "Code snippet", "type": "textarea", "required": true },
    { "key": "language", "label": "Language", "type": "text", "required": false, "placeholder": "e.g. Python" }
  ],
  "systemPrompt": "You are a code tutor. Given a code snippet and its language, explain what the code does line by line in plain language, then give a one-paragraph summary of its overall purpose.",
  "outputFormat": "markdown",
  "model": "default",
  "testCases": [
    { "inputs": { "code": "for i in range(10):\n    print(i)", "language": "Python" }, "mustInclude": ["loop", "print"] },
    { "inputs": { "code": "function add(a, b) { return a + b; }", "language": "JavaScript" }, "mustInclude": ["function", "return"] }
  ]
}
